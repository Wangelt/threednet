# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/3dforge

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Firebase Admin (server-side only; never expose these to the browser)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Frontend / Admin (CORS + email links)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
# Production example:
# CLIENT_URL=https://your-store.vercel.app
# ADMIN_URL=https://threedadmin.vercel.app
# CORS_ORIGINS=https://threedadmin.vercel.app,https://your-store.vercel.app
# Optional extra origins (comma-separated)
# CORS_ORIGINS=https://admin.yourdomain.com,https://store.yourdomain.com

# Shipping
SHIPPING_FLAT_RATE=49
SHIPPING_FREE_ABOVE=999
COD_ENABLED=true

# Razorpay (optional until live payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=3dforge

# Email (optional — if unset, verify/reset links are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=3D Forge <noreply@3dforge.local>

# Seed accounts (optional)
# SEED_ADMIN_EMAIL=admin@3dforge.local
# SEED_ADMIN_PASSWORD=Admin12345!
# SEED_SUPER_ADMIN_EMAIL=superadmin@3dforge.local
# SEED_SUPER_ADMIN_PASSWORD=SuperAdmin12345!
