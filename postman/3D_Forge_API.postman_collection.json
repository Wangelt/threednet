              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Custom anime figurine stand with engraved nameplate, about 15cm tall.\",\n  \"preferredMaterial\": \"Resin\",\n  \"preferredColor\": \"Matte Black\",\n  \"quantity\": 1,\n  \"dimensions\": { \"length\": 10, \"width\": 10, \"height\": 15, \"unit\": \"cm\" },\n  \"budgetRange\": { \"min\": 800, \"max\": 1500 },\n  \"preferredContact\": \"email\",\n  \"additionalNotes\": \"Please include felt pads on base.\"\n}"
            },
            "url": "{{baseUrl}}/custom-orders"
          }
        },
        {
