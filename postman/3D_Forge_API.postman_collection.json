    {
      "name": "12. Custom Orders",
      "item": [
        {
          "name": "Create Custom Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('customOrderId', pm.response.json().data.request.requestId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
